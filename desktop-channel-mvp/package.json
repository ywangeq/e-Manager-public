{
  "name": "e-manager-local-group-studio",
  "productName": "e-Manager Group Studio Local",
  "description": "Local Group Studio workspace for e-Manager",
  "author": "WANG YUAN",
  "version": "3.0.0-beta.32",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "desktop:start": "electron electron/main.mjs",
    "native:build:macos-sandbox": "node tools/build-managed-sandbox-helper.mjs",
    "desktop:package": "pnpm build && pnpm native:build:macos-sandbox && electron-builder --config electron-builder.config.cjs --mac zip --arm64"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-gfm": "^4.0.1",
    "three": "0.171.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.emanager.local.groupstudio",
    "productName": "e-Manager Group Studio Local",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-channel.config.json",
        "to": "desktop-channel.config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "e-Manager-Local-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "e-Manager-Local-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "extraMetadata": {
      "digitalWorkforceProduct": "e-manager-local-group-studio"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
